# KINETIA: variables del contenedor api (docs/CONTRATOS.md, sección 6).
# Copia este archivo a .env y arranca desde la raíz del repositorio:
#   backend\.venv\Scripts\python -m uvicorn app.main:app --app-dir backend --env-file .env --port 8000
# Los valores de abajo son los del contrato (dentro del pod). Para desarrollo local en Windows usa,
# por ejemplo: MODELS_DIR=models/dev, RESULTS_DIR=data/results, DB_PATH=data/db/kinetia.db,
# TMP_DIR=data/tmp y ALLOW_DUMMY_MODEL=true.

# Carpeta de modelos
MODELS_DIR=/models
# Modelo de segmentación
SEG_MODEL_FILE=kinetia_seg.onnx
# Modelo de profundidad
DEPTH_MODEL_FILE=midas_small.onnx
# Resultados
RESULTS_DIR=/data/results
# SQLite (modo WAL)
DB_PATH=/data/db/kinetia.db
# Temporales
TMP_DIR=/shared-tmp/api
# Umbral de confianza por píxel
CONF_THRESHOLD=0.5
# 15 MiB
MAX_UPLOAD_BYTES=15728640
# Duración máxima de video, en segundos
MAX_VIDEO_SECONDS=10
# Frames máximos; un video con más fps se remuestrea
MAX_FRAMES=300
# Resolución mínima (lado menor)
MIN_SIDE_PX=256
# Resolución máxima de entrada, en píxeles totales
MAX_PIXELS=40000000
# Lado mayor de trabajo
WORK_MAX_SIDE=1280
# Inferencia cada N frames de video
VIDEO_INFER_EVERY_N=5
# Regla de noche (0 a 255)
NIGHT_LUMA_THRESHOLD=60
# Regla de bosque (%)
FOREST_MIN_PCT=25
# Jobs en cola antes de responder 429
MAX_QUEUE=8
# Limpieza de resultados, en horas
RESULT_TTL_HOURS=96
# Hilos de ONNX Runtime
ORT_INTRA_OP_THREADS=4
# URL del QR. `make demo` la fija con la IP de la red local
PUBLIC_BASE_URL=http://localhost:8080
# true solo en desarrollo local. Prohibido en k8s/ y en docker-compose.yml
ALLOW_DUMMY_MODEL=false
# Nivel de log
LOG_LEVEL=INFO
# Moderación de galería. Secreto: en producción viene de kinetia-secret
ADMIN_TOKEN=
